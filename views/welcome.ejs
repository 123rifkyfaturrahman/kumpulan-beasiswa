<!-- JAVASCRIPT -->
<script>
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuButton && mobileMenu) {
        menuButton.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    }

    (function () {
        const bookmarkStorageKey = 'caribeasiswa:bookmarks:v1';
        const bookmarkDetailsStorageKey = 'caribeasiswa:bookmark-details:v1';
        const badge = document.getElementById('header-bookmark-badge');

        function readStorage(key, fallback) {
            try {
                const value = localStorage.getItem(key);
                return value ? JSON.parse(value) : fallback;
            } catch (error) {
                return fallback;
            }
        }

        const savedIds = new Set(readStorage(bookmarkStorageKey, []).map(String));
        const bookmarkDetails = readStorage(bookmarkDetailsStorageKey, {});

        function syncUI() {
            if (badge) badge.textContent = savedIds.size;
            document.querySelectorAll('.bookmark-btn').forEach(function (button) {
                const id = String(button.dataset.scholarshipId);
                const isSaved = savedIds.has(id);
                button.classList.toggle('text-secondary', isSaved);
                const iconEl = button.querySelector('.material-symbols-outlined');
                if (iconEl) {
                    iconEl.textContent = isSaved ? 'bookmark' : 'bookmark_border';
                }
            });
        }

        document.querySelectorAll('.bookmark-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                const id = String(button.dataset.scholarshipId);
                if (savedIds.has(id)) {
                    savedIds.delete(id);
                    delete bookmarkDetails[id];
                } else {
                    savedIds.add(id);
                    bookmarkDetails[id] = {
                        id: id,
                        title: button.dataset.scholarshipTitle,
                        provider: button.dataset.scholarshipProvider,
                        level: button.dataset.scholarshipLevel,
                        funding: button.dataset.scholarshipFunding,
                        location: button.dataset.scholarshipLocation,
                        deadline: button.dataset.scholarshipDeadline,
                        status: button.dataset.scholarshipStatus,
                        url: button.dataset.scholarshipUrl,
                        icon: 'school',
                        program_type: button.dataset.scholarshipProgramType,
                        category: 'beranda',
                        savedAt: Date.now()
                    };
                }
                localStorage.setItem(bookmarkStorageKey, JSON.stringify(Array.from(savedIds)));
                localStorage.setItem(bookmarkDetailsStorageKey, JSON.stringify(bookmarkDetails));
                syncUI();
            });
        });

        syncUI();
    })();
</script>

</body>
